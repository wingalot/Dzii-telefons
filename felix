#!/bin/bash
#
# FELIX MASTER - Unified Control Script
# One command to rule them all
#

WORKSPACE="$HOME/.openclaw/workspace"
SUPERVISOR="$HOME/.openclaw/ai_supervisor"
TRADING="$HOME/.trading"
PID_DIR="$SUPERVISOR/state"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

log() {
    echo -e "${GREEN}[FELIX MASTER]${NC} $1"
}

warn() {
    echo -e "${YELLOW}[FELIX MASTER]${NC} $1"
}

error() {
    echo -e "${RED}[FELIX MASTER]${NC} $1"
}

info() {
    echo -e "${BLUE}[FELIX MASTER]${NC} $1"
}

# Check status
status() {
    log "System Status"
    log "============="
    
    # Check Signal Hub
    if [ -f "$PID_DIR/signal_hub.pid" ] && kill -0 $(cat "$PID_DIR/signal_hub.pid") 2>/dev/null; then
        log "🟢 Signal Hub: RUNNING"
    else
        error "🔴 Signal Hub: STOPPED"
    fi
    
    # Check TP Manager
    if [ -f "$PID_DIR/tp_manager.pid" ] && kill -0 $(cat "$PID_DIR/tp_manager.pid") 2>/dev/null; then
        log "🟢 TP Manager: RUNNING"
    else
        error "🔴 TP Manager: STOPPED"
    fi
    
    # Check IG positions
    info "Checking IG positions..."
    bash "$TRADING/ig_api.sh" positions 2>/dev/null | grep -E '"instrumentName"|"dealId"' | head -10
    
    # Local positions
    if [ -f "$PID_DIR/tp_manager_state.json" ]; then
        local_count=$(python3 -c "import json; d=json.load(open('$PID_DIR/tp_manager_state.json')); p=d.get('positions', {}); print(sum(1 for v in p.values() if v.get('status')=='open'))" 2>/dev/null)
        local_total=$(python3 -c "import json; d=json.load(open('$PID_DIR/tp_manager_state.json')); print(len(d.get('positions', {})))" 2>/dev/null)
        info "Local Open Positions: $local_count (total tracked: $local_total)"
    fi
}

# Start all
start() {
    log "🚀 Starting Felix Master System..."
    
    # Clean up old state if needed
    if [ "$1" == "--clean" ]; then
        warn "Cleaning old state..."
        mv "$PID_DIR/tp_manager_state.json" "$PID_DIR/tp_manager_state_backup_$(date +%Y%m%d_%H%M%S).json" 2>/dev/null || true
        echo '{"positions":{},"pending_limits":{}}' > "$PID_DIR/tp_manager_state.json"
    fi
    
    # Start Signal Hub
    if [ ! -f "$PID_DIR/signal_hub.pid" ] || ! kill -0 $(cat "$PID_DIR/signal_hub.pid") 2>/dev/null; then
        log "Starting Signal Hub..."
        cd "$SUPERVISOR"
        nohup python3 felix_signal_hub.py > "$SUPERVISOR/logs/signal_hub.log" 2>&1 &
        echo $! > "$PID_DIR/signal_hub.pid"
        sleep 2
    else
        warn "Signal Hub already running"
    fi
    
    # Start TP Manager
    if [ ! -f "$PID_DIR/tp_manager.pid" ] || ! kill -0 $(cat "$PID_DIR/tp_manager.pid") 2>/dev/null; then
        log "Starting TP Manager..."
        cd "$SUPERVISOR"
        nohup python3 felix_tp_manager.py > "$SUPERVISOR/logs/tp_manager.log" 2>&1 &
        echo $! > "$PID_DIR/tp_manager.pid"
        sleep 2
    else
        warn "TP Manager already running"
    fi
    
    log "🎉 Felix Master System started!"
    status
}

# Stop all
stop() {
    log "🛑 Stopping Felix Master System..."
    
    # Stop Signal Hub
    if [ -f "$PID_DIR/signal_hub.pid" ]; then
        kill $(cat "$PID_DIR/signal_hub.pid") 2>/dev/null || true
        rm -f "$PID_DIR/signal_hub.pid"
        log "Signal Hub stopped"
    fi
    
    # Stop TP Manager
    if [ -f "$PID_DIR/tp_manager.pid" ]; then
        kill $(cat "$PID_DIR/tp_manager.pid") 2>/dev/null || true
        rm -f "$PID_DIR/tp_manager.pid"
        log "TP Manager stopped"
    fi
    
    log "✅ System stopped"
}

# Restart
restart() {
    stop
    sleep 2
    start "$@"
}

# Test parser
test_parser() {
    log "🧪 Testing Smart Parser..."
    cd "$SUPERVISOR"
    python3 felix_smart_parser.py
}

# View logs
logs() {
    if [ "$1" == "hub" ]; then
        tail -f "$SUPERVISOR/logs/signal_hub.log"
    elif [ "$1" == "tp" ]; then
        tail -f "$SUPERVISOR/logs/tp_manager.log"
    else
        tail -f "$SUPERVISOR/logs/signal_hub.log" "$SUPERVISOR/logs/tp_manager.log"
    fi
}

# Sync positions with IG
sync() {
    log "🔄 Syncing with IG positions..."
    cd "$SUPERVISOR"
    python3 felix_tp_manager.py --sync
}

# Show help
help() {
    echo "Felix Master - Unified Trading System Control"
    echo ""
    echo "Usage: felix-master [command] [options]"
    echo ""
    echo "Commands:"
    echo "  start [--clean]    Start all systems (with optional state cleanup)"
    echo "  stop               Stop all systems"
    echo "  restart [--clean]  Restart all systems"
    echo "  status             Show system status"
    echo "  test               Test smart parser"
    echo "  sync               Sync local positions with IG"
    echo "  logs [hub|tp]      View logs (or both)"
    echo "  help               Show this help"
}

# Main
case "${1:-help}" in
    start)
        start "$2"
        ;;
    stop)
        stop
        ;;
    restart)
        restart "$2"
        ;;
    status)
        status
        ;;
    test)
        test_parser
        ;;
    sync)
        sync
        ;;
    logs)
        logs "$2"
        ;;
    help|--help|-h)
        help
        ;;
    *)
        error "Unknown command: $1"
        help
        exit 1
        ;;
esac
